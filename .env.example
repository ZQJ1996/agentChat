# Model provider: mock | openai | ollama
MODEL_PROVIDER=mock

# OpenAI-compatible settings (also works with many Chinese gateways)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_GRAPH_STEPS=12
MAX_TOOL_RETRIES=1
RETRIEVAL_TOP_K=5
RERANK_TOP_N=3
EVIDENCE_MIN_SCORE=0.08
MAX_TOKENS_PER_REQUEST=4096
TEMPERATURE=0.2

# Paths (relative to project root)
KNOWLEDGE_DIR=data/knowledge
CHROMA_DIR=data/chroma
SQLITE_PATH=data/sqlite/agent.db
GOLDEN_SET_PATH=data/eval/golden_set.jsonl
EVAL_REPORT_DIR=reports
